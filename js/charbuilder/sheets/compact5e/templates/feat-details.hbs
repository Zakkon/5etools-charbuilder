<h3 class="form-header">Feature Details</h3>

{{!-- Feature Properties --}}
<div class="feature-properties form-group stacked">
    <label>Feature Properties</label>
    {{#each properties}}
    <label class="checkbox">
        <input type="checkbox" name="system.properties.{{ @key }}" {{ checked selected }}> {{ label }}
    </label>
    {{/each}}
</div>

<h3 class="form-header">Feature Usage</h3>
{{!-- Item Activation Template --}}
{{> "dnd5e.item-activation"}}

<h3 class="form-header">Feature Attack</h3>
 {{!-- Item Action Template --}}
{{> "dnd5e.item-action"}}